pragma solidity ^0.8.24;
import {AgentTreasury,IERC20} from "../src/AgentTreasury.sol";
contract MockUSDC is IERC20 {mapping(address=>uint256) public balanceOf;mapping(address=>mapping(address=>uint256)) public allowance;function mint(address to,uint256 amount) external{balanceOf[to]+=amount;}function approve(address s,uint256 a) external returns(bool){allowance[msg.sender][s]=a;return true;}function transfer(address to,uint256 a) external returns(bool){balanceOf[msg.sender]-=a;balanceOf[to]+=a;return true;}function transferFrom(address f,address t,uint256 a) external returns(bool){allowance[f][msg.sender]-=a;balanceOf[f]-=a;balanceOf[t]+=a;return true;}}
contract Worker {function submit(AgentTreasury t,uint256 id,bytes32 d,bytes32 h,uint128 c) external{t.submitWork(id,d,h,c);}}
contract AgentTreasuryTest {MockUSDC token;AgentTreasury treasury;Worker worker;bytes32 constant MARKETING=keccak256("MARKETING");constructor(){token=new MockUSDC();treasury=new AgentTreasury(address(token));worker=new Worker();}function testFullLifecycle() external{token.mint(address(this),10_000_000);token.approve(address(treasury),10_000_000);uint256 id=treasury.createProject(keccak256("toolos-project"),uint64(block.timestamp+7 days));treasury.fundProject(id,10_000_000);treasury.assignDepartment(id,MARKETING,address(worker),3_000_000);worker.submit(treasury,id,MARKETING,keccak256("deliverable"),2_000_000);treasury.approveAndPay(id,MARKETING);require(token.balanceOf(address(worker))==2_000_000);treasury.closeProject(id);require(token.balanceOf(address(this))==8_000_000);}}
